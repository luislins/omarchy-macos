#!/usr/bin/env bash
#
# aeroassign -- diz em qual workspace cada app deve abrir.
#
# Lista os apps que estao rodando agora, voce escolhe o workspace de cada um,
# e ele monta as regras do 'on-window-detected' para o ~/.aerospace.toml.
#
# Evita o unico passo chato: descobrir o bundle ID de cada app (o do Cursor,
# por exemplo, e uma string ilegivel gerada pelo ToDesktop).
#
# Uso:
#   aeroassign            # monta as regras e mostra na tela
#   aeroassign --apply    # alem de mostrar, grava no ~/.aerospace.toml
#
# Abra antes todos os apps que quer organizar -- so aparece o que esta rodando.

set -euo pipefail

CONFIG="${AEROSPACE_CONFIG:-$HOME/.aerospace.toml}"
AEROSPACE_BIN="${AEROSPACE_BIN:-aerospace}"
APPLY=0
[ "${1:-}" = "--apply" ] && APPLY=1

if [ -t 1 ]; then
  BOLD=$'\033[1m'; BLUE=$'\033[38;5;111m'; GREEN=$'\033[38;5;150m'
  DIM=$'\033[38;5;103m'; YELLOW=$'\033[38;5;179m'; RESET=$'\033[0m'
else
  BOLD=''; BLUE=''; GREEN=''; DIM=''; YELLOW=''; RESET=''
fi

command -v "$AEROSPACE_BIN" >/dev/null 2>&1 || {
  echo "aeroassign: comando 'aerospace' nao encontrado" >&2; exit 1; }
[ -f "$CONFIG" ] || { echo "aeroassign: nao achei $CONFIG" >&2; exit 1; }

# bundle-id <TAB> nome, ordenado por nome
APPS="$("$AEROSPACE_BIN" list-apps --format '%{app-bundle-id}%{tab}%{app-name}' \
        | grep -v '^[[:space:]]*$' | sort -t"$(printf '\t')" -k2)"

[ -n "$APPS" ] || { echo "aeroassign: nenhum app rodando?" >&2; exit 1; }

printf '%sApps rodando agora.%s Para cada um, digite o workspace (1-9).\n' "$BOLD" "$RESET"
printf '%sEnter sozinho = deixar solto, sem regra fixa.%s\n\n' "$DIM" "$RESET"

REGRAS=""
N=0
while IFS=$'\t' read -r bundle nome <&3; do
  [ -n "$bundle" ] || continue
  N=$((N + 1))

  # ja existe regra de workspace para esse app?
  if grep -q "app-bundle-id} = ${bundle}'.*move-node-to-workspace" "$CONFIG" 2>/dev/null; then
    ja=" ${DIM}(ja tem regra)${RESET}"
  else
    ja=""
  fi

  printf '  %s%-28s%s %s%s%s%s\n' "$BLUE" "$nome" "$RESET" "$DIM" "$bundle" "$RESET" "$ja"
  printf '    workspace> '
  read -r ws || ws=""

  case "$ws" in
    "" ) continue ;;
    [1-9] ) ;;
    * ) printf '    %signorado: "%s" nao e de 1 a 9%s\n' "$YELLOW" "$ws" "$RESET"; continue ;;
  esac

  REGRAS="${REGRAS}    { if = 'test %{app-bundle-id} = ${bundle}', run = 'move-node-to-workspace ${ws}' },  # ${nome}
"
done 3<<< "$APPS"

if [ -z "$REGRAS" ]; then
  printf '\n%snenhuma regra criada.%s\n' "$YELLOW" "$RESET"
  exit 0
fi

printf '\n%s── regras geradas ──%s\n%s' "$BOLD" "$RESET" "$REGRAS"

if [ "$APPLY" -eq 0 ]; then
  printf '\n%sNada foi gravado.%s Cole as linhas acima dentro do bloco\n' "$YELLOW" "$RESET"
  printf 'on-window-detected = [ ... ] do %s,\n' "$CONFIG"
  printf 'ou rode de novo com --apply.\n'
  exit 0
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="${CONFIG}.bak-${STAMP}"
cp "$CONFIG" "$BACKUP"

python3 - "$CONFIG" "$REGRAS" <<'PY'
import sys

caminho, regras = sys.argv[1], sys.argv[2]
linhas = open(caminho).read().split("\n")

inicio = next((i for i, l in enumerate(linhas)
               if l.strip().startswith("on-window-detected")), None)
if inicio is None:
    sys.exit("aeroassign: nao achei o bloco on-window-detected")

fim = next((i for i in range(inicio + 1, len(linhas))
            if linhas[i].strip() == "]"), None)
if fim is None:
    sys.exit("aeroassign: nao achei o fechamento ] do bloco")

novas = [l for l in regras.split("\n") if l.strip()]
linhas[fim:fim] = novas
open(caminho, "w").write("\n".join(linhas))
print(f"inseridas {len(novas)} regras antes da linha {fim + 1}")
PY

printf '\n%sgravado.%s backup: %s\n' "$GREEN" "$RESET" "$BACKUP"
printf 'A config recarrega sozinha. Feche e reabra os apps para ver o efeito.\n'
printf '\nSe algo quebrar:  cp %s %s\n' "$BACKUP" "$CONFIG"
