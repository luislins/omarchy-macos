#!/usr/bin/env bash
#
# aerokeys -- mostra os atalhos do AeroSpace lendo o SEU ~/.aerospace.toml.
#
# E o equivalente do 'Super + K' do Omarchy: em vez de uma lista decorada que
# envelhece, ele imprime o que esta valendo agora. Se voce editar a config,
# a saida muda junto.
#
# Instalar:
#   mkdir -p ~/.local/bin && cp aerokeys ~/.local/bin/ && chmod +x ~/.local/bin/aerokeys
#
# Usar:
#   aerokeys          # tudo
#   aerokeys work     # so as linhas que casam com 'work' (ex: workspace)

set -euo pipefail

CONFIG="${AEROSPACE_CONFIG:-$HOME/.aerospace.toml}"
FILTRO="${1:-}"

if [ ! -f "$CONFIG" ]; then
  echo "aerokeys: nao achei $CONFIG" >&2
  exit 1
fi

# Sem cor quando a saida nao e um terminal (ex: 'aerokeys | grep')
if [ -t 1 ]; then
  C_TIT=$'\033[1m'; C_COM=$'\033[38;5;103m'; C_KEY=$'\033[38;5;111m'; C_OFF=$'\033[0m'
else
  C_TIT=''; C_COM=''; C_KEY=''; C_OFF=''
fi

saida="$(
  awk -v tit="$C_TIT" -v com="$C_COM" -v key="$C_KEY" -v off="$C_OFF" '
    /^\[mode\.main\.binding\]/    { m=1; printf "\n%s── MODO PRINCIPAL ──%s\n", tit, off; next }
    /^\[mode\.service\.binding\]/ { m=1; printf "\n%s── MODO SERVICE (Alt+Shift+;) ──%s\n", tit, off; next }
    m != 1 { next }

    # comentarios viram cabecalhos de secao
    /^[[:space:]]*#/ {
      c = $0
      sub(/^[[:space:]]*#[[:space:]]?/, "", c)
      sub(/^[-[:space:]]+/, "", c)
      sub(/[-[:space:]]+$/, "", c)
      if (c != "") printf "\n  %s%s%s\n", com, c, off
      next
    }

    index($0, "=") == 0 { next }

    # chave = valor, descartando comentario de fim de linha
    {
      k = substr($0, 1, index($0, "=") - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)

      v = substr($0, index($0, "=") + 1)
      q1 = index(v, "\047")
      if (q1 > 0) {
        resto = substr(v, q1 + 1)
        q2 = index(resto, "\047")
        v = (q2 > 0) ? substr(resto, 1, q2 - 1) : resto
      } else {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      }

      printf "    %s%-20s%s %s\n", key, k, off, v
    }
  ' "$CONFIG"
)"

if [ -n "$FILTRO" ]; then
  printf '%s\n' "$saida" | grep -i -- "$FILTRO" || {
    echo "aerokeys: nada casou com '$FILTRO'" >&2
    exit 1
  }
else
  printf '%s\n' "$saida"
  printf '\n  %sAlt = Option (⌥). Config: %s%s\n' "$C_COM" "$CONFIG" "$C_OFF"
fi
